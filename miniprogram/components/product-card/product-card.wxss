/* 产品卡片组件样式 */
/* 注意：CSS 变量从页面级继承，无需 @import */

.product-card {
  background: #FFFFFF;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: row;
  padding: 16rpx;
}

/* 图片区域 */
.product-image-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background-color: #F8F8F8;
  margin-right: 16rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 信息区域 */
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.product-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  background-color: #F56C6C;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 6rpx;
  position: absolute;
  top: 0;
  left: 0;
  border-radius: 0 0 6rpx 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #303133;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  gap: 12rpx;
}

.category-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  background-color: #F5F0EB;
  color: #8B7355;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.unit-text {
  font-size: 22rpx;
  color: #909399;
}

/* 价格区域 */
.price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.price-wholesale-label {
  font-size: 22rpx;
  color: #909399;
}

.price-wholesale {
  font-size: 36rpx;
  font-weight: 700;
  color: #F56C6C;
}

.price-retail {
  font-size: 22rpx;
  color: #C0C4CC;
  text-decoration: line-through;
}

/* 操作按钮 */
.action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.btn-add-inquiry {
  padding: 8rpx 20rpx;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 22rpx;
  border: none;
  border-radius: 6rpx;
}

.btn-add-inquiry:active {
  background-color: #6B5B45;
}

.btn-disabled {
  background-color: #67C23A;
}
