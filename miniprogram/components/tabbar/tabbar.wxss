/* 底部导航组件样式 */
@import "../../style/variables.wxss";

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: var(--tab-bar-height);
  padding-bottom: var(--tab-bar-safe-area-bottom);
  background-color: var(--color-bg-white);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  border-top: 2rpx solid var(--color-border-extra-light);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.04);
  z-index: 999;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  -webkit-tap-highlight-color: transparent;
}

.tabbar-item:active {
  opacity: 0.7;
}

.tabbar-icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
}

.tabbar-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.2;
}

/* 选中态 */
.tabbar-item-active .tabbar-icon {
  /* 选中图标由 src 控制 */
}

.tabbar-item-active .tabbar-text {
  color: var(--color-primary);
  font-weight: 500;
}

/* 角标 */
.tabbar-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  background-color: var(--color-danger);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.tabbar-badge-text {
  color: var(--color-text-white);
  font-size: 18rpx;
  line-height: 1;
  font-weight: 500;
  transform: scale(0.85);
  /* 保持比例缩放 */
}
