<!-- 注册页 -->
<view class="page-register">
  <view class="register-container">
    <!-- 顶部标题 -->
    <view class="header-section">
      <text class="header-title">创建账号</text>
      <text class="header-desc">注册栖居家具账号，开启询价之旅</text>
    </view>

    <!-- 注册表单 -->
    <view class="form-section">
      <!-- 用户名 -->
      <view class="form-item">
        <text class="form-label">用户名 <text class="required-star">*</text></text>
        <view class="input-wrapper">
          <input
            class="form-input"
            type="text"
            placeholder="请输入用户名"
            placeholder-class="input-placeholder"
            value="{{username}}"
            bindinput="onUsernameInput"
            maxlength="30"
          />
        </view>
      </view>

      <!-- 昵称 -->
      <view class="form-item">
        <text class="form-label">昵称</text>
        <view class="input-wrapper">
          <input
            class="form-input"
            type="text"
            placeholder="请输入您的昵称（选填）"
            placeholder-class="input-placeholder"
            value="{{nickname}}"
            bindinput="onNicknameInput"
            maxlength="30"
          />
        </view>
      </view>

      <!-- 密码 -->
      <view class="form-item">
        <text class="form-label">密码 <text class="required-star">*</text></text>
        <view class="input-wrapper">
          <input
            class="form-input"
            type="{{showPassword ? 'text' : 'password'}}"
            placeholder="请输入密码（至少6位）"
            placeholder-class="input-placeholder"
            value="{{password}}"
            bindinput="onPasswordInput"
            maxlength="32"
          />
          <image
            class="eye-icon"
            src="/assets/icons/{{showPassword ? 'eye-open' : 'eye-close'}}.png"
            mode="aspectFit"
            bindtap="onTogglePassword"
          ></image>
        </view>
      </view>

      <!-- 确认密码 -->
      <view class="form-item">
        <text class="form-label">确认密码 <text class="required-star">*</text></text>
        <view class="input-wrapper">
          <input
            class="form-input"
            type="{{showConfirmPassword ? 'text' : 'password'}}"
            placeholder="请再次输入密码"
            placeholder-class="input-placeholder"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
            maxlength="32"
          />
          <image
            class="eye-icon"
            src="/assets/icons/{{showConfirmPassword ? 'eye-open' : 'eye-close'}}.png"
            mode="aspectFit"
            bindtap="onToggleConfirmPassword"
          ></image>
        </view>
      </view>

      <!-- 公司名称 -->
      <view class="form-item">
        <text class="form-label">公司名称 <text class="required-star">*</text></text>
        <view class="input-wrapper">
          <input
            class="form-input"
            type="text"
            placeholder="请输入公司名称"
            placeholder-class="input-placeholder"
            value="{{companyName}}"
            bindinput="onCompanyNameInput"
            maxlength="100"
          />
        </view>
      </view>

      <!-- 手机号 -->
      <view class="form-item">
        <text class="form-label">手机号 <text class="required-star">*</text></text>
        <view class="input-wrapper">
          <input
            class="form-input"
            type="number"
            placeholder="请输入手机号"
            placeholder-class="input-placeholder"
            value="{{phone}}"
            bindinput="onPhoneInput"
            maxlength="11"
          />
        </view>
      </view>

      <!-- 注册按钮 -->
      <button
        class="register-btn {{isRegistering ? 'btn-disabled' : ''}}"
        disabled="{{isRegistering}}"
        loading="{{isRegistering}}"
        bindtap="onRegister"
      >
        {{isRegistering ? '注册中...' : '注 册'}}
      </button>
    </view>

    <!-- 底部操作区 -->
    <view class="footer-section">
      <view class="login-link" bindtap="onGoLogin">
        <text>已有账号？</text>
        <text class="link-text">去登录</text>
      </view>
    </view>
  </view>
</view>
