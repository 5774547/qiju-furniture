<!-- 我的询价单页 -->
<view class="page-inquiries">
  <!-- 空状态 -->
  <view wx:if="{{inquiries.length === 0 && !loading}}" class="empty-state">
    <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit"></image>
    <text class="empty-text">暂无询价单</text>
    <text class="empty-hint">浏览产品，提交您的第一份询价单</text>
    <button class="btn-browse" bindtap="onBrowseProducts">去浏览产品</button>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && inquiries.length === 0}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 询价单列表 -->
  <view wx:else class="inquiry-list">
    <view
      class="inquiry-card"
      wx:for="{{inquiries}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCardTap"
    >
      <!-- 卡片头部：单号 + 状态 -->
      <view class="card-header">
        <view class="inquiry-no-wrap">
          <text class="inquiry-no-label">询价单</text>
          <text class="inquiry-no">{{item.inquiryNo || '#' + item.id}}</text>
        </view>
        <view class="status-tag status-{{item.status}}">
          <text>{{statusText[item.status] || '未知'}}</text>
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">联系人</text>
          <text class="info-value">{{item.customerName}}</text>
        </view>
        <view class="info-row" wx:if="{{item.customerPhone}}">
          <text class="info-label">电话</text>
          <text class="info-value">{{item.customerPhone}}</text>
        </view>
        <view class="info-row" wx:if="{{item.quotationAmount !== null && item.quotationAmount !== undefined}}">
          <text class="info-label">报价金额</text>
          <text class="info-value info-value-price">¥{{item.quotationAmount}}</text>
        </view>
      </view>

      <!-- 卡片底部：时间 -->
      <view class="card-footer">
        <text class="create-time">{{formatTime(item.createTime)}}</text>
        <text class="arrow-icon">›</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-placeholder"></view>
</view>
