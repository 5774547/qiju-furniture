<!-- 产品列表页 -->
<view class="page-products">
  <!-- 搜索过滤 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit"></image>
      <input
        class="search-input"
        placeholder="搜索产品名称..."
        placeholder-style="color: var(--color-text-placeholder)"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        confirm-type="search"
      ></input>
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">✕</text>
    </view>
  </view>

  <!-- 分类 Tab 切换 -->
  <scroll-view class="category-tabs" scroll-x="true" show-scrollbar="{{false}}">
    <view
      class="category-tab {{currentCategory === '' ? 'category-tab-active' : ''}}"
      data-category=""
      bindtap="onCategoryTabTap"
    >
      全部
    </view>
    <view
      class="category-tab {{currentCategory === item.name ? 'category-tab-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="name"
      data-category="{{item.name}}"
      bindtap="onCategoryTabTap"
    >
      {{item.name}}
      <text wx:if="{{item.count !== undefined}}" class="category-count">({{item.count}})</text>
    </view>
  </scroll-view>

  <!-- 产品网格列表 -->
  <view class="product-grid">
    <view wx:if="{{loading && products.length === 0}}" class="loading-container">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{products.length === 0}}" class="empty-state">
      <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit"></image>
      <text>暂无产品</text>
    </view>

    <view wx:else class="product-list">
      <product-card
        wx:for="{{products}}"
        wx:key="id"
        product="{{item}}"
        inInquiryList="{{item.inInquiryList}}"
        bind:addinquiry="onAddInquiry"
      ></product-card>
    </view>
  </view>

  <!-- 加载更多提示 -->
  <view wx:if="{{hasMore && products.length > 0}}" class="load-more-hint">
    <text>上拉加载更多</text>
  </view>
  <view wx:elif="{{!hasMore && products.length > 0}}" class="load-more-hint load-more-done">
    <text>— 已加载全部产品 —</text>
  </view>

  <!-- 底部留白 -->
  <view class="tabbar-placeholder"></view>
</view>
