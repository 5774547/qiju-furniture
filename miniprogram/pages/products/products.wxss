/* 产品列表页样式 */
@import "../../style/variables.wxss";

.page-products {
  padding-bottom: var(--spacing-lg);
}

/* 搜索栏 */
.search-bar {
  padding: var(--spacing-base) var(--spacing-lg);
  background-color: var(--color-bg-white);
  position: sticky;
  top: 0;
  z-index: 20;
}

.search-input-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: 0 var(--spacing-base);
  height: 72rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  height: 100%;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  background-color: var(--color-border-base);
  color: var(--color-text-white);
  border-radius: var(--radius-circle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 分类 Tab */
.category-tabs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  background-color: var(--color-bg-white);
  padding: var(--spacing-xs) var(--spacing-lg);
  border-bottom: 2rpx solid var(--color-border-extra-light);
  position: sticky;
  top: 104rpx;
  z-index: 20;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  margin-right: var(--spacing-xs);
  font-size: var(--font-size-base);
  color: var(--color-text-regular);
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.category-tab:active {
  background-color: var(--color-primary-bg);
}

.category-tab-active {
  color: var(--color-primary);
  font-weight: 600;
  background-color: var(--color-primary-bg);
}

.category-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  margin-left: 4rpx;
}

/* 产品网格 */
.product-grid {
  padding: var(--spacing-sm) var(--spacing-lg) 0;
  min-height: 60vh;
}

.product-list {
  display: flex;
  flex-direction: column;
}

/* 空状态 */
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-base);
}

/* 加载更多 */
.load-more-hint {
  text-align: center;
  padding: var(--spacing-lg) 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
}

.load-more-done {
  color: var(--color-border-base);
}

/* 底部留白 */
.tabbar-placeholder {
  height: calc(var(--tab-bar-height) + var(--tab-bar-safe-area-bottom));
}
