/* 提交询价页样式 */
@import "../../style/variables.wxss";

.page-inquiry-create {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 160rpx;
}

/* 表单区块 */
.form-section {
  background-color: var(--color-bg-white);
  margin-bottom: var(--spacing-base);
  padding: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-base);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--color-border-extra-light);
}

.form-group {
  padding-top: var(--spacing-sm);
}

.form-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--spacing-base) 0;
  border-bottom: 2rpx solid var(--color-border-extra-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-textarea {
  align-items: flex-start;
}

.form-label {
  width: 140rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.form-label.required::before {
  content: '*';
  color: var(--color-danger);
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  height: 56rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  padding: 0 var(--spacing-sm);
}

.form-textarea {
  flex: 1;
  height: 120rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  padding: var(--spacing-sm);
  line-height: 1.6;
}

/* 产品清单 */
.product-list {
  padding-top: var(--spacing-sm);
}

.product-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--spacing-base) 0;
  border-bottom: 2rpx solid var(--color-border-extra-light);
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-base);
  background-color: var(--color-bg);
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: var(--spacing-base);
  min-width: 0;
}

.product-name {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.product-detail {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.product-price {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

/* 提交按钮 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--spacing-base) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-base) + var(--tab-bar-safe-area-bottom));
  background-color: var(--color-bg-white);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: var(--color-primary);
  color: var(--color-text-white);
  font-size: var(--font-size-lg);
  font-weight: 600;
  border-radius: var(--radius-lg);
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  background-color: var(--color-primary-dark);
}

.btn-submit-disabled {
  background-color: var(--color-border-base);
  color: var(--color-text-white);
}

/* 底部占位 */
.bottom-placeholder {
  height: 160rpx;
}
