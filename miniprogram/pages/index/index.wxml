<!-- 首页 -->
<view class="page-index">
  <!-- 顶部搜索框 -->
  <view class="search-bar">
    <view class="search-box" bindtap="onSearchTap">
      <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit"></image>
      <text class="search-placeholder">搜索家具、品类...</text>
    </view>
  </view>

  <!-- 分类导航网格 -->
  <view class="section">
    <view class="section-title">产品分类</view>
    <view class="category-grid">
      <view
        class="category-item"
        wx:for="{{categories}}"
        wx:key="name"
        data-category="{{item.name}}"
        bindtap="onCategoryTap"
      >
        <view class="category-icon-wrapper">
          <image class="category-icon" src="{{item.icon || '/assets/icons/category-default.png'}}" mode="aspectFit"></image>
        </view>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 热门产品列表 -->
  <view class="section">
    <view class="section-title">
      <text>热门产品</text>
      <text class="section-more" bindtap="onViewAllProducts">查看全部 ›</text>
    </view>
    <view class="product-list">
      <product-card
        wx:for="{{hotProducts}}"
        wx:key="id"
        product="{{item}}"
        inInquiryList="{{item.inInquiryList}}"
        bind:addinquiry="onAddInquiry"
      ></product-card>
    </view>
  </view>

  <!-- 工厂介绍区块 -->
  <view class="section factory-section">
    <view class="section-title">关于栖居</view>
    <view class="factory-card">
      <image class="factory-image" src="/assets/icons/factory-placeholder.png" mode="aspectFill"></image>
      <view class="factory-info">
        <text class="factory-name">栖居家具工厂</text>
        <text class="factory-desc">深耕家具行业十余年，专注实木家具设计与制造。从选材到成品，每一道工序都精益求精，为客户提供高品质、环保耐用的家具产品。</text>
        <view class="factory-stats">
          <view class="stat-item">
            <text class="stat-value">500+</text>
            <text class="stat-label">合作客户</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">2000+</text>
            <text class="stat-label">产品款式</text>
          </view>
          <view class="stat-item">
            <text class="stat-value">98%</text>
            <text class="stat-label">好评率</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部留白给 tabbar -->
  <view class="tabbar-placeholder"></view>
</view>
