/* 首页样式 */
@import "../../style/variables.wxss";

.page-index {
  padding-bottom: var(--spacing-lg);
}

/* 搜索栏 */
.search-bar {
  padding: var(--spacing-base) var(--spacing-lg);
  background-color: var(--color-bg-white);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-sm) var(--spacing-base);
  height: 72rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.search-placeholder {
  color: var(--color-text-placeholder);
  font-size: var(--font-size-base);
}

/* 分区标题 */
.section {
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-lg);
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-base);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.section-more {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 400;
}

/* 分类网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-base);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg) var(--spacing-base);
  box-shadow: var(--shadow-sm);
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.category-item:active {
  opacity: 0.7;
}

.category-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background-color: var(--color-primary-bg);
  border-radius: var(--radius-circle);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-xs);
}

.category-icon {
  width: 44rpx;
  height: 44rpx;
}

.category-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
  line-height: 1.4;
}

/* 产品列表 */
.product-list {
  margin-top: var(--spacing-xs);
}

/* 工厂介绍 */
.factory-section {
  margin-top: var(--spacing-lg);
}

.factory-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.factory-image {
  width: 100%;
  height: 320rpx;
  background-color: var(--color-primary-bg);
}

.factory-info {
  padding: var(--spacing-base) var(--spacing-lg) var(--spacing-lg);
}

.factory-name {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.factory-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: block;
}

.factory-stats {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-base);
  border-top: 2rpx solid var(--color-border-extra-light);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 底部留白 */
.tabbar-placeholder {
  height: calc(var(--tab-bar-height) + var(--tab-bar-safe-area-bottom) + var(--spacing-lg));
}
